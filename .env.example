# Rename/copy to .env.local for local development.
# Never commit real credentials.

### Application
NEXTAUTH_URL=http://app.localhost:3000
NEXT_PUBLIC_ROOT_DOMAIN=example.com
DATABASE_URL=
POSTGRES_URL=
NEXTAUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
OPENAI_API_KEY=

### Supabase (publishable client values only)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

### Developer Cloud / Deployment Provider
# Primary MVP provider: Coolify
DEPLOYMENT_PROVIDER=coolify
COOLIFY_BASE_URL=https://coolify.example.com
COOLIFY_API_TOKEN=
COOLIFY_PROJECT_UUID=
COOLIFY_ENVIRONMENT_UUID=
COOLIFY_SERVER_UUID=
# Optional when the target server has multiple destinations
COOLIFY_DESTINATION_UUID=
